# Copia este archivo como ".env" (en la misma carpeta que config.yaml) y rellena lo que uses.
# Todo es opcional: sin nada, los avisos salen solo en pantalla.

# Telegram: crea un bot con @BotFather; tu chat id te lo da @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy (app gratuita para el móvil, sin registro): un nombre difícil de adivinar
NTFY_TOPIC=

# Google Shopping en toda Europa + EE. UU. (https://serpapi.com)
SERPAPI_KEY=

# Si no quieres descargar el Chromium de Playwright, ruta a tu Chrome/Chromium
CHROMIUM_PATH=
